# Reference/reset-to-defaults copy of ../deploy.tfvars, which is the file that actually matters
# — it's tracked in git and read by both scripts/*.sh and .github/workflows/deploy.yml (see its
# own header comment for why it has to be tracked, unlike terraform.tfvars). This .example file
# is just a clean starting point if you ever need to regenerate deploy.tfvars from scratch;
# scripts/*.sh never touch this one, only the real deploy.tfvars.
frontend_mode           = "firebase"
enable_redis            = false
enable_elasticsearch    = false
load_balancer_domain    = ""
firebase_custom_domain  = ""
enable_sql_read_replica = false
backend_max_instances   = 2
