project_id = "your-gcp-project-id"
region     = "us-central1"

# Blank (the default, so omitting this line entirely is fine) skips creating any load-monitoring
# alerts — see monitoring.tf and infra/README.md's "Load monitoring" section. Set this to get an
# email when backend/database CPU crosses a threshold, pointing you at which scripts/*.sh to
# consider running.
# alert_notification_email = "you@example.com"
